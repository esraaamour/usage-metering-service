# Copy this file to .env and adjust the values.

# PostgreSQL connection string.
# Local:           postgres://postgres:postgres@localhost:5432/metering
# Docker Compose:  postgres://postgres:postgres@db:5432/metering
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metering

# Port the service listens on.
PORT=3000

# Max connections in the PostgreSQL pool.
DB_POOL_MAX=20

# Optional. If set, POST /accounts requires the header: x-admin-token: <value>
# Leave empty to allow anyone to create accounts (fine for local demos).
ADMIN_TOKEN=

# Set to "test" to silence request logs during automated tests.
NODE_ENV=development
